{
  "name": "super8-backend",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "generate": "prisma generate",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "build": "npm run generate",
    "postinstall": "prisma generate",
    "deploy-local": "npm run build-frontend && node server.js",
    "build-frontend": "cd ../frontend && npm install && npm run build && cd ../backend && rm -rf dist 2>/dev/null; mkdir -p dist && cp -r ../frontend/dist/* ./dist/",
    "db:push": "prisma db push",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^6.18.0",
    "nodemon": "^3.1.0"
  }
}
