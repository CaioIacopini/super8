{
  "name": "react-api-monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm i -ws",
    "dev": "npm-run-all -p dev:*",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "start": "npm-run-all -p start:*",
    "start:api": "npm --prefix backend start",
    "start:web": "npm --prefix frontend start",
    "db:push": "npm --prefix backend run db:push",
    "db:studio": "npm --prefix backend run studio"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "npm-run-all": "^4.1.5",
    "vite": "^7.1.12"
  }
}
